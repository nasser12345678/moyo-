# Frontend build-time configuration
VITE_OPENROUTER_API_KEY=

# Netlify Function runtime configuration. These override the public fallback
# already configured for this project; set them when moving projects or rotating keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Local-only: required only when running `node execute_sql.cjs` to apply the migration.
# Never commit this value.
SUPABASE_DB_URL=postgresql://postgres:password@host:6543/postgres
